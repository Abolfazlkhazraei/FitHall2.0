TEAM_ID=

PRODUCT_NAME=FitHall
PRODUCT_BUNDLE_IDENTIFIER=com.fithall.app$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// FitHall server. The simulator reaches a server on this Mac at localhost; for a real iPhone use
// the Mac's network address, e.g. http:/$()/192.168.1.20:8080. ("//" starts a comment in xcconfig
// files, so the URL is written as http:/$()/... which Xcode turns back into http://.)
FITHALL_BACKEND_URL = http:/$()/localhost:8080
