<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- The FitHall server the app talks to; set FITHALL_BACKEND_URL in Configuration/Config.xcconfig. -->
	<key>FitHallBackendURL</key>
	<string>$(FITHALL_BACKEND_URL)</string>
	<!-- Development: allow plain HTTP to a server on this Mac or the local network.
	     Your deployed server must use HTTPS, which needs no exception. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
